generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum PayType {
  HOURLY
  SALARY
}

model User {
  id                  String         @id @default(uuid())
  login               String         @unique
  passwordHash        String
  role                Role           @default(EMPLOYEE)
  mustChangePassword  Boolean        @default(false)
  employee            Employee?
  refreshTokens       RefreshToken[]
  createdAt           DateTime       @default(now())
}

model Employee {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  firstName   String
  lastName    String
  daysPerWeek Int
  hiredAt     DateTime
  isActive    Boolean  @default(true)

  terms           EmployeeTerms[]
  shifts          Shift[]
  sickDays        SickDay[]
  overtimePayouts OvertimePayout[]

  @@index([isActive])
}

model EmployeeTerms {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payType       PayType
  hourlyRate    Decimal?  @db.Decimal(10, 2)
  monthlySalary Decimal?  @db.Decimal(10, 2)
  hoursPerDay   Decimal   @db.Decimal(4, 2)
  validFrom     DateTime  @db.Date
  validTo       DateTime? @db.Date

  @@index([employeeId, validFrom])
}

model Shift {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  date          DateTime  @db.Date
  startTime     DateTime
  endTime       DateTime
  breakStart    DateTime?
  breakEnd      DateTime?
  workedMinutes Int
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId, date])
}

model SickDay {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime @db.Date
  note       String?

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

model OvertimePayout {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime @db.Date
  hoursPaid  Decimal  @db.Decimal(6, 2)
  amount     Decimal  @db.Decimal(10, 2)
  note       String?

  @@index([employeeId, date])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  entity      String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
}
