{
    "name": "worktable-backend",
    "private": true,
    "type": "module",
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "test": "vitest run",
        "test:int": "vitest run --config vitest.int.config.ts",
        "test:coverage": "vitest run --coverage",
        "test:int:coverage": "vitest run --config vitest.int.config.ts --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --max-warnings 0",
        "format": "prettier --check ."
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "decimal.js": "^10.6.0",
        "express": "^4.21.2",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.13.10",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "^4.1.11",
        "audit-ci": "^7.1.0",
        "eslint": "^10.9.1",
        "fast-check": "^4.9.0",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "prisma": "^6.19.3",
        "supertest": "^7.2.2",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.68.0",
        "vitest": "^4.1.11"
    }
}
